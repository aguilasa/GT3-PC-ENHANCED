#!/bin/sh
# AppRun - the entry point of the GT3 PC AppImage (scripts/package-appimage.sh).
#
#   GT3PC-i686.AppImage [game arguments]      runs the game (gt3pc)
#   GT3PC-i686.AppImage --install <image.iso>  installs the game files from a
#   GT3PC-i686.AppImage --unpack <gt3.vol>     disc image (gt3launcher)
#   GT3PC-i686.AppImage launcher [arguments]   runs gt3launcher with the
#                                              arguments as they are
#
# The programs run from the AppImage itself.  The game keeps gt3pc.ini, its
# log, the save folders, the screenshots and its caches in GT3PC_HOME, by
# default $XDG_DATA_HOME/gt3pc (~/.local/share/gt3pc), and the installer
# puts the game files there by default (src/platform/posix/user_dir.h).  It
# is set here because the programs' folder is not always read-only: without
# FUSE the AppImage is extracted into a temporary folder, removed at the exit.
set -eu

here=$(dirname "$(readlink -f "$0")")
app=$here/usr/lib/gt3pc
GT3PC_HOME=${GT3PC_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/gt3pc}
export GT3PC_HOME

case ${1-} in
--install | --unpack)
    exec "$app/gt3launcher" "$@"
    ;;
launcher)
    shift
    exec "$app/gt3launcher" "$@"
    ;;
esac
exec "$app/gt3pc" "$@"
