# The demo replays an install writes over the disc's (src/launcher/install.cpp
# write_demos) off Windows: every file of demo/ as a byte array of one
# generated C++ source, with the lookup install.cpp calls,
#
#   extern "C" const unsigned char *gt3pc_demo_file(size_t index, const char **name, size_t *size);
#
# (the index-th file by name, its bytes as they are; null past the last).
# Windows builds them in as GT3DEMO resources instead
# (src/launcher/CMakeLists.txt).  Run by the build:
#
#   cmake -DOUT=<file.cpp> -DDEMO_DIR=<repo>/demo -P cmake/demos.cmake
#
# The source is written only when its text changes (what depends on it is
# not rebuilt for nothing).
if(NOT OUT OR NOT DEMO_DIR)
    message(FATAL_ERROR "demos.cmake: -DOUT=<file.cpp> -DDEMO_DIR=<demo folder> are needed")
endif()

file(GLOB demos LIST_DIRECTORIES false ${DEMO_DIR}/*)
list(SORT demos)

set(text "/* Generated by cmake/demos.cmake from the files of demo/: do not edit. */\n")
string(APPEND text "#include <stddef.h>\n\nnamespace {\n")
set(table "")
set(index 0)
foreach(demo ${demos})
    get_filename_component(name ${demo} NAME)
    if(NOT name MATCHES "^[A-Za-z0-9_.-]+$")
        message(WARNING "demos.cmake: ${demo}: not a demo replay's name, skipped")
        continue()
    endif()
    file(READ ${demo} hex HEX)
    string(LENGTH "${hex}" n)
    math(EXPR size "${n} / 2")
    # 32 bytes a line (CMake's expressions have no {n})
    string(REPEAT "[0-9a-f][0-9a-f]" 32 line)
    string(REGEX REPLACE "(${line})" "\\1\n" hex "${hex}")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND text "const unsigned char k_${index}[${size} + 1] = {\n${bytes}0};\n")
    string(APPEND table "    {\"${name}\", k_${index}, ${size}},\n")
    math(EXPR index "${index} + 1")
endforeach()
string(APPEND text "struct Demo {\n    const char *name;\n    const unsigned char *data;\n    size_t size;\n};\n")
string(APPEND text "const Demo kDemos[] = {\n${table}    {nullptr, nullptr, 0},\n};\n} // namespace\n\n")
string(APPEND text [=[
extern "C" const unsigned char *gt3pc_demo_file(size_t index, const char **name, size_t *size)
{
    for (size_t i = 0; kDemos[i].name != nullptr; i++)
        if (i == index) {
            *name = kDemos[i].name;
            *size = kDemos[i].size;
            return kDemos[i].data;
        }
    *name = nullptr;
    *size = 0;
    return nullptr;
}
]=])

set(tmp ${OUT}.tmp)
file(WRITE ${tmp} "${text}")
file(COPY_FILE ${tmp} ${OUT} ONLY_IF_DIFFERENT)
file(REMOVE ${tmp})
