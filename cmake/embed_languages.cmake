# The interface's catalogues off Windows (src/platform/ui_text.cpp): every
# lang/<code>.po as a byte array of one generated C++ source, with the lookup
# ui_text.cpp calls,
#
#   extern "C" const unsigned char *gt3pc_ui_text_catalogue(const char *code, size_t *size);
#
# (the file's bytes as they are, not NUL-terminated; null for a code without
# a catalogue).  Windows builds them in as GT3LANG resources instead
# (cmake/languages.cmake).  Run by the build, after tools/lang_sync:
#
#   cmake -DOUT=<file.cpp> -DLANG_DIR=<repo>/lang -P cmake/embed_languages.cmake
#
# The source is written only when its text changes (what depends on it is
# not rebuilt for nothing).
if(NOT OUT OR NOT LANG_DIR)
    message(FATAL_ERROR "embed_languages.cmake: -DOUT=<file.cpp> -DLANG_DIR=<lang folder> are needed")
endif()

file(GLOB pos LIST_DIRECTORIES false ${LANG_DIR}/*.po)
list(SORT pos)

set(text "/* Generated by cmake/embed_languages.cmake from the lang/<code>.po files: do not edit. */\n")
string(APPEND text "#include <stddef.h>\n#include <string.h>\n\nnamespace {\n")
set(table "")
foreach(po ${pos})
    get_filename_component(code ${po} NAME_WE)
    if(NOT code MATCHES "^[A-Za-z0-9_]+$")
        message(WARNING "embed_languages.cmake: ${po}: not a catalogue's name, skipped")
        continue()
    endif()
    file(READ ${po} hex HEX)
    string(LENGTH "${hex}" n)
    math(EXPR size "${n} / 2")
    # 32 bytes a line (CMake's expressions have no {n})
    string(REPEAT "[0-9a-f][0-9a-f]" 32 line)
    string(REGEX REPLACE "(${line})" "\\1\n" hex "${hex}")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND text "const unsigned char k_${code}[${size} + 1] = {\n${bytes}0};\n")
    string(APPEND table "    {\"${code}\", k_${code}, ${size}},\n")
endforeach()
string(APPEND text "struct Catalogue {\n    const char *code;\n    const unsigned char *data;\n    size_t size;\n};\n")
string(APPEND text "const Catalogue kCatalogues[] = {\n${table}    {nullptr, nullptr, 0},\n};\n} // namespace\n\n")
string(APPEND text [=[
extern "C" const unsigned char *gt3pc_ui_text_catalogue(const char *code, size_t *size)
{
    for (const Catalogue *c = kCatalogues; c->code != nullptr; c++)
        if (strcmp(c->code, code) == 0) {
            *size = c->size;
            return c->data;
        }
    *size = 0;
    return nullptr;
}
]=])

set(tmp ${OUT}.tmp)
file(WRITE ${tmp} "${text}")
file(COPY_FILE ${tmp} ${OUT} ONLY_IF_DIFFERENT)
file(REMOVE ${tmp})
