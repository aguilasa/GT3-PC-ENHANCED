"THE SAME CAP IN MS, 0.01 A STEP (HOLD: FASTER);\n"
"BELOW 1 MS, OFF."
msgstr ""
"LO STESSO LIMITE IN MS, A PASSI DI 0.01 (TENERE PREMUTO: PIÙ RAPIDO);\n"
"SOTTO 1 MS: NO."

#: src/platform/settings_menu.cpp
