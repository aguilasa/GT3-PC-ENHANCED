msgid ""
"RESOLUTION, ANTI-ALIASING, DETAIL.\n"
"SMOKE OPACITY. REAR VIEW."
msgstr ""
"RISOLUZIONE, ANTI-ALIASING, DETTAGLIO.\n"
"OPACITÀ FUMO. RETROVISORE."

