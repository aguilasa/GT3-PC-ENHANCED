msgid "A folder's name cannot start with a space, nor end with a space or a dot."
msgstr "Le nom d'un dossier ne peut pas commencer par un espace, ni se terminer par un espace ou un point."

#: src/platform/save_folders.cpp
msgid "That name is one Windows keeps for a device (CON, NUL, COM1 ...)."
msgstr "Ce nom est réservé par Windows à un périphérique (CON, NUL, COM1...)."

#: src/platform/save_folders.cpp
msgid "That name has characters gt3pc_engine.ini cannot keep: use plainer letters."
msgstr "Ce nom contient des caractères que gt3pc_engine.ini ne peut pas conserver : utiliser des lettres plus simples."

