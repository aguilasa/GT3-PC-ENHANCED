#: src/platform/settings_menu.cpp
msgid ""
"NOTHING IS MAPPED TO THE CLUTCH\n"
"ADD ONE IN THE LAUNCHER: CONTROLS, A CONTROLLER\n"
"OR A WHEEL, CLUTCH. UNTIL THEN THE GEARS\n"
"SHIFT AS REALISTIC."
msgstr ""
"RIEN N'EST ASSIGNÉ À L'EMBRAYAGE\n"
"EN AJOUTER UN DANS LE LANCEUR: COMMANDES, UNE MANETTE\n"
"OU UN VOLANT, EMBRAYAGE. D'ICI LÀ, LES RAPPORTS\n"
"PASSENT COMME EN RÉALISTE."

