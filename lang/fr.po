msgid ""
"SCREEN MODE, MENU ASPECT, VERTICAL SYNC, FRAME RATE\n"
"AND FRAME TIMES."
msgstr ""
"MODE D'ÉCRAN, FORMAT DES MENUS, SYNCHRO VERTICALE,\n"
"LIMITE DE FPS ET TEMPS D'IMAGE."

#: src/platform/settings_menu.cpp
msgid "SCREEN MODE"
msgstr "MODE D'ÉCRAN"

#: src/platform/settings_menu.cpp
msgid ""
"WINDOWED: A RESIZABLE WINDOW.\n"
"BORDERLESS: A WINDOW COVERING THE MONITOR.\n"
"FULLSCREEN: EXCLUSIVE, THE MONITOR'S DISPLAY MODE."
msgstr ""
"FENÊTRÉ: UNE FENÊTRE REDIMENSIONNABLE.\n"
"SANS BORDURE: UNE FENÊTRE COUVRANT L'ÉCRAN.\n"
"PLEIN ÉCRAN: EXCLUSIF, AU MODE D'AFFICHAGE DE L'ÉCRAN."

#: src/platform/settings_menu.cpp
msgid "MENU ASPECT"
msgstr "FORMAT DES MENUS"

#: src/platform/settings_menu.cpp
msgid "MOVIE ASPECT"
msgstr "FORMAT DES VIDÉOS"

#: src/platform/settings_menu.cpp
msgid "VERTICAL SYNC"
msgstr "SYNCHRO VERTICALE"

#: src/platform/settings_menu.cpp
msgid ""
"OFF: NO VSYNC.\n"
"1-3: VSYNC ON, NUMBER OF BUFFERED FRAMES.\n"
"1 FRAME PROVIDES THE BEST FRAME PACING\n"
"IF YOUR MACHINE CAN MAINTAIN FRAME RATE."
msgstr ""
"DÉSACTIVÉ: PAS DE VSYNC.\n"
"1-3: VSYNC ACTIVÉE, NOMBRE D'IMAGES EN TAMPON.\n"
"1 IMAGE DONNE LA MEILLEURE RÉGULARITÉ D'AFFICHAGE\n"
"SI LA MACHINE PEUT TENIR LA FRÉQUENCE D'IMAGES."

#: src/platform/settings_menu.cpp
msgid "FRAME RATE CAP"
msgstr "LIMITE DE FPS"

#: src/platform/settings_menu.cpp
msgid ""
"THE FRAMES AT MOST THIS OFTEN (A FRAME TIME CAP);\n"
"OFF: AS FAST AS THEY ARE DRAWN."
msgstr ""
"LES IMAGES AU PLUS À CETTE FRÉQUENCE (UNE LIMITE DE TEMPS D'IMAGE);\n"
"DÉSACTIVÉ: AUSSI VITE QU'ELLES SONT DESSINÉES."

#: src/platform/settings_menu.cpp
msgid "  FRAME TIME CAP"
msgstr "  LIMITE DE TEMPS D'IMAGE"

#: src/platform/settings_menu.cpp
msgid ""
"THE SAME CAP IN MS, 0.01 A STEP (HOLD: FASTER);\n"
"BELOW 1 MS, OFF."
msgstr ""
"LA MÊME LIMITE EN MS, PAR PAS DE 0.01 (MAINTENIR: PLUS VITE);\n"
"SOUS 1 MS, DÉSACTIVÉE."

#: src/platform/settings_menu.cpp
msgid "FRAME TIME MONITOR"
msgstr "MONITEUR DE TEMPS D'IMAGE"

#: src/platform/settings_menu.cpp
msgid ""
"THE FRAME TIMES OVER THE TOP LEFT CORNER.\n"
"DETAILED: WITH THE FRAME TIME'S BREAKDOWN.\n"
"VERBOSE: ALSO THE GPU'S TIME BY SECTION."
msgstr ""
"LES TEMPS D'IMAGE DANS LE COIN SUPÉRIEUR GAUCHE.\n"
"DÉTAILLÉ: AVEC LA RÉPARTITION DU TEMPS D'IMAGE.\n"
"COMPLET: AUSSI LE TEMPS GPU PAR SECTION."

#: src/platform/settings_menu.cpp
msgid "GRAPHICS"
msgstr "GRAPHISMES"

#: src/platform/settings_menu.cpp
msgid ""
"RESOLUTION, ANTI-ALIASING, DETAIL.\n"
"SMOKE OPACITY. REAR VIEW."
msgstr ""
"RÉSOLUTION, ANTICRÉNELAGE, DÉTAIL.\n"
"OPACITÉ DE LA FUMÉE. RÉTROVISEUR."

#: src/platform/settings_menu.cpp
msgid "RESOLUTION SCALE"
msgstr "ÉCHELLE DE RÉSOLUTION"

#: src/platform/settings_menu.cpp
msgid ""
"THE GAME'S RESOLUTION, OF THE WINDOW'S.\n"
"ABOVE 100%: SCALED DOWN TO THE WINDOW\n"
"(SUPERSAMPLING AA); MORE GPU. ENTER: 100%."
msgstr ""
"LA RÉSOLUTION DU JEU, RELATIVE À CELLE DE LA FENÊTRE.\n"
"AU-DESSUS DE 100%: RÉDUITE À LA FENÊTRE\n"
"(AA PAR SURÉCHANTILLONNAGE); PLUS DE GPU. ENTRÉE: 100%."

#: src/platform/settings_menu.cpp
msgid "ANTI-ALIASING"
msgstr "ANTICRÉNELAGE"

#: src/platform/settings_menu.cpp
msgid ""
"FXAA: THE RACE VIEWS' 3D, BEFORE THE HUD.\n"
"MSAA: EVERY PICTURE, MENUS TOO; MORE GPU.\n"
"AGSS: MSAA WITH THE 3D SHADED AT EVERY SAMPLE (SUPERSAMPLING):\n"
"TEXTURE EDGES (TREES, FENCES) AND SHIMMER TOO; MUCH MORE GPU."
msgstr ""
"FXAA: LA 3D DES VUES DE COURSE, AVANT LE HUD.\n"
"MSAA: TOUTES LES IMAGES, MENUS COMPRIS; PLUS DE GPU.\n"
"AGSS: MSAA AVEC LA 3D CALCULÉE À CHAQUE ÉCHANTILLON (SURÉCHANTILLONNAGE):\n"
"BORDS DE TEXTURES (ARBRES, CLÔTURES), SCINTILLEMENT; BIEN PLUS DE GPU."

#: src/platform/settings_menu.cpp
msgid "ANISOTROPIC FILTERING"
msgstr "FILTRAGE ANISOTROPE"

#: src/platform/settings_menu.cpp
msgid ""
"SHARPER TEXTURES ON SURFACES SEEN AT AN ANGLE (THE ROAD).\n"
"THE TRANSPARENT PARTS OF TEXTURES ADD NO COLOR (NO HIDDEN COLORS SHOWING)."
msgstr ""
"TEXTURES PLUS NETTES SUR LES SURFACES VUES DE BIAIS (LA ROUTE).\n"
"LES PARTIES TRANSPARENTES DES TEXTURES N'AJOUTENT AUCUNE COULEUR\n"
"(PAS DE COULEURS CACHÉES VISIBLES)."

#: src/platform/settings_menu.cpp
msgid "LEVELS OF DETAIL"
msgstr "NIVEAUX DE DÉTAIL"

#: src/platform/settings_menu.cpp
msgid "BEST: CARS, COURSES, AND SPLIT-SCREEN ALWAYS AT FULL DETAIL."
msgstr "TOUJOURS LE MEILLEUR: VOITURES, CIRCUITS ET ÉCRAN PARTAGÉ AU DÉTAIL MAXIMAL."

#: src/platform/settings_menu.cpp
msgid "ROAD REFLECTION"
msgstr "REFLET DE LA ROUTE"

#: src/platform/settings_menu.cpp
msgid "HIGH IMPACT ON FRAME RATE WITH MANY CARS."
msgstr "FORT IMPACT SUR LES FPS AVEC BEAUCOUP DE VOITURES."

#: src/platform/settings_menu.cpp
msgid "ROAD REFLECTION RESOLUTION"
msgstr "RÉSOLUTION DU REFLET DE LA ROUTE"

#: src/platform/settings_menu.cpp
msgid ""
