#: src/platform/settings_menu.cpp
msgid ""
"THE AMOUNT OF CARS IN A RACE.\n"
" IF A RACE HAS A LIMIT, IT WILL NEED TO BE OVERRIDDEN WITH THE SETTING BELOW."
msgstr ""
"LE NOMBRE DE VOITURES DANS UNE COURSE.\n"
" SI UNE COURSE A UNE LIMITE, IL FAUT L'IGNORER AVEC LE RÉGLAGE CI-DESSOUS."

#: src/platform/settings_menu.cpp
msgid "  OVERRIDE RACE LIMITS"
msgstr "  IGNORER LES LIMITES DES COURSES"

